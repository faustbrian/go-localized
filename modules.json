      "purpose": "`localized` provides immutable UTF-8 text keyed by canonical BCP 47 language tags. Exact lookup, language matching, and application fallback are separate operations. The package does not provide catalogs, formatting, pluralization, translation loading, language detection, or global locale policy.",
      "lifecycle": "stable",
      "kind": "public library",
      "releasable": true,
      "family": "foundations",
      "family_label": "Foundations",
      "family_description": "Common immutable values, deterministic seams, configuration, identity propagation, and input validation.",
      "family_order": 1,
      "cohesion": {
        "family": "foundations",
        "secondary_capabilities": [
          "configuration",
          "data-encoding",
          "database-and-storage",
          "http-and-service-edge",
          "protocols-and-schemas",
          "testing-and-conformance",
          "transport-and-networking"
        ],
        "responsibility": "Provide immutable localized text values, exact locale lookup, deterministic matching and fallback, and focused configuration, encoding, HTTP, persistence, validation, and wire integrations.",
        "non_goals": [
          "Provide translation catalogs, message loading, formatting, pluralization, interpolation, or language detection.",
          "Own application-wide fallback or process-global locale policy.",
          "Hide locale identity, matching, persistence, transport, or validation behind a framework runtime."
        ],
        "public_package_identifier": "localized",
        "primary_entry_packages": [
          "github.com/faustbrian/go-localized/v5"
        ],
        "package_selection": {
          "github.com/faustbrian/go-localized/v5": "Use for immutable localized text values, exact locale lookup, bounded construction, persistent transforms, merge policy, and canonical JSON.",
          "github.com/faustbrian/go-localized/v5/adapters/config": "Use to decode localized text through the Golib configuration contract.",
          "github.com/faustbrian/go-localized/v5/adapters/httpclient": "Use to add Accept-Language preferences to immutable HTTP-client request specifications and select localized responses.",
          "github.com/faustbrian/go-localized/v5/adapters/query": "Use for exact locale-aware values and predicates in API-query plans.",
          "github.com/faustbrian/go-localized/v5/adapters/validation": "Use for reusable localized-text validation and explicit Unicode normalization.",
          "github.com/faustbrian/go-localized/v5/adapters/wire": "Use to encode and decode localized text through bounded Golib wire formats.",
          "github.com/faustbrian/go-localized/v5/encoding": "Use for the ordered entry-array encoding that preserves locale and localized-text boundaries.",
          "github.com/faustbrian/go-localized/v5/http": "Use for bounded Accept-Language parsing and selection with explicit matching semantics.",
          "github.com/faustbrian/go-localized/v5/localizedconfig": "Compatibility import for adapters/config.",
          "github.com/faustbrian/go-localized/v5/localizedhttpclient": "Compatibility import for adapters/httpclient.",
          "github.com/faustbrian/go-localized/v5/localizedquery": "Compatibility import for adapters/query.",
          "github.com/faustbrian/go-localized/v5/localizedtest": "Use in tests for deterministic localized fixtures and assertions.",
          "github.com/faustbrian/go-localized/v5/localizedvalidation": "Compatibility import for adapters/validation.",
          "github.com/faustbrian/go-localized/v5/localizedwire": "Compatibility import for adapters/wire.",
          "github.com/faustbrian/go-localized/v5/match": "Use for standards-aligned language matching and explicit application fallback plans.",
          "github.com/faustbrian/go-localized/v5/postgres": "Use for SQL values, rows, and pgx JSONB integration backed by caller-owned database resources."
        },
